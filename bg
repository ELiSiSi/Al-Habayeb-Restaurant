
:root {
  --main-color: #000;
  --secondary-color: #ffd000;
  --ramadan-gold: #ffd700;
}

html {
  scroll-behavior: smooth;
}

* {
  -webkit-box-sizing: border-box;
  -moz-box-sizing: border-box;
  box-sizing: border-box;
}

body {
  --main-color: #ffffff;
  background-color: #000000;
  width: 100%;


  position: relative;
  z-index: 0;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: -1;
}

/* رمضان كريم كبيرة في الخلفية */
body::after {
  content: "رمضان كريم";
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 120px;
  font-weight: 900;
  color: rgba(255, 208, 0, 0.06);
  z-index: 0;
  pointer-events: none;
  white-space: nowrap;
}

/* فانوس يسار أعلى */
.lantern-left {
  position: fixed;
  top: 8%;
  left: 2%;
  font-size: 55px;
  animation: swing-right 4s infinite ease-in-out;
  filter: drop-shadow(0 0 15px #ffd000);
  z-index: 9999;
}

.lantern-left::before {
  content: "🏮";
}

/* فانوس يمين أعلى */
.lantern-right {
  position: fixed;
  top: 8%;
  right: 2%;
  font-size: 55px;
  animation: swing-left 4s infinite ease-in-out;
  filter: drop-shadow(0 0 15px #ffd000);
  z-index: 9999;
}

.lantern-right::before {
  content: "🏮";
}

/* فانوس يسار وسط */
.lantern-left-bottom {
  position: fixed;
  top: 45%;
  left: 1%;
  font-size: 50px;
  animation: swing-right 3.5s infinite ease-in-out;
  filter: drop-shadow(0 0 15px rgba(255, 208, 0, 0.9));
  z-index: 1;
}

.lantern-left-bottom::before {
  content: "🏮";
}

/* فانوس يمين وسط */
.lantern-right-bottom {
  position: fixed;
  top: 45%;
  right: 1%;
  font-size: 50px;
  animation: swing-left 3.5s infinite ease-in-out;
  filter: drop-shadow(0 0 15px rgba(255, 208, 0, 0.9));
  z-index: 1;
}

.lantern-right-bottom::before {
  content: "🏮";
}

@keyframes swing-right {
  0%, 100% {
    transform: rotate(-15deg) translateY(0);
  }
  50% {
    transform: rotate(15deg) translateY(-10px);
  }
}

@keyframes swing-left {
  0%, 100% {
    transform: rotate(15deg) translateY(0);
  }
  50% {
    transform: rotate(-15deg) translateY(-10px);
  }
}

/* أضواء رمضانية في الأعلى */
.ramadan-lights {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 60px;
  pointer-events: none;
  z-index: 9998;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  gap: 40px;
  padding: 0 20px;
}

.light {
  font-size: 30px;
  display: inline-block;
}

.light:nth-child(1) {
  animation: blink1 1.5s infinite;
  filter: drop-shadow(0 0 10px #ffd000);
}

.light:nth-child(2) {
  animation: blink2 1.5s infinite;
  filter: drop-shadow(0 0 10px #ffffff);
}

.light:nth-child(3) {
  animation: blink1 1.5s infinite 0.5s;
  filter: drop-shadow(0 0 10px #ffd000);
}

.light:nth-child(4) {
  animation: blink2 1.5s infinite 0.5s;
  filter: drop-shadow(0 0 10px #ffffff);
}

.light:nth-child(5) {
  animation: blink1 1.5s infinite 1s;
  filter: drop-shadow(0 0 10px #ffd000);
}

.light::before {
  content: "💡";
}

@keyframes blink1 {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.9); }
}

@keyframes blink2 {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1); }
}

@media (max-width: 500px) {
  body::after {
    font-size: 50px;
  }

  .lantern-left,
  .lantern-right {
    font-size: 40px;
  }

  .lantern-left {
    left: 1%;
    top: 6%;
  }

  .lantern-right {
    right: 1%;
    top: 6%;
  }

  .lantern-left-bottom,
  .lantern-right-bottom {
    font-size: 35px;
  }

  .ramadan-lights {
    gap: 15px;
    height: 50px;
  }

  .light {
    font-size: 22px;
  }
}

.container {
  width: 90%;
  margin: auto;
  position: relative;
  z-index: 2;
}

/* start header */
.header {
  background: linear-gradient(135deg, #ffd000 0%, #ffed4e 100%);
  position: relative;
  box-shadow: 0 6px 20px rgba(255, 208, 0, 0.5);
  margin-top: 25px;
  border-radius: 15px;
}

/* رمضان كريم على الهيدر */
.header::before {
  content: "🌙 رمضان كريم 🌙";
  position: absolute;
  top: 30px;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(90deg, #000000, #ffd000, #000000);
  color: white;
  padding: 8px 30px;
  border-radius: 25px;
  font-size: 30px;
  font-weight: bold;
  box-shadow: 0 0 20px rgba(255, 208, 0, 0.9);
  animation: glow-text 2s infinite alternate;
  white-space: nowrap;
  z-index: 10;
}

@keyframes glow-text {
  from {
    box-shadow: 0 0 15px rgba(255, 208, 0, 0.6);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }
  to {
    box-shadow: 0 0 30px rgba(255, 208, 0, 1);
    text-shadow: 0 0 20px rgba(255, 255, 255, 1);
  }
}

.header .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
}

.header img {
  width: 110px;
  margin: 0px;
  padding: 0px;
  animation: thebest 2s infinite;
  filter: drop-shadow(0 0 12px rgba(0, 0, 0, 0.4));
  border-radius: 15px;
}

@keyframes thebest {
  0% {
    translate: 0 0;
  }
  50% {
    translate: 20px 0;
    filter: drop-shadow(0 0 18px rgba(255, 208, 0, 0.8));
  }
  100% {
    translate: 0 0;
  }
}

.header .container .name {
  color: #000;
  font-weight: 900;
  font-size: x-large;
  text-shadow: 2px 2px 4px rgba(255, 208, 0, 0.3);
}

.header .container .name span {
  color: var(--secondary-color);
}

@media (max-width: 768px) {
  .header {
    height: auto;
    margin-top: 20px;
    padding: 10px 0;
  }

  .header::before {
    font-size: 20px;
    padding: 5px 15px;
    top: 5px;
  }

  .header img {
    width: 60px;
  }

  .header .container .name {
    font-size: 16px;
  }

  body {
    background-color: var(--main-color);
    width: 100%;
    background-image: url("../image/back2.jpg");
    background-size: cover;
    background-attachment: fixed;
  }
}

/* start profile */
.profile {
  text-align: center;
  color: #ffd000;
  padding-top: 30px;
  padding-bottom: 20px;
  direction: rtl;
  position: relative;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20px;
  margin-top: 20px;
  border: 2px solid rgba(255, 208, 0, 0.4);
}

/* هلال ونجوم حول الصورة */
.profile::before {
  content: "🌙";
  position: absolute;
  top: 15px;
  left: 50%;
  transform: translateX(-150px);
  font-size: 45px;
  animation: rotate-moon 10s infinite linear;
  filter: drop-shadow(0 0 15px #ffd000);
}

.profile::after {
  content: "⭐";
  position: absolute;
  top: 15px;
  right: 50%;
  transform: translateX(150px);
  font-size: 40px;
  animation: twinkle-star 2s infinite;
  filter: drop-shadow(0 0 15px #ffd000);
}

@keyframes rotate-moon {
  0% { transform: translateX(-150px) rotate(0deg); }
  100% { transform: translateX(-150px) rotate(360deg); }
}

@keyframes twinkle-star {
  0%, 100% {
    opacity: 1;
    transform: translateX(150px) scale(1);
  }
  50% {
    opacity: 0.5;
    transform: translateX(150px) scale(1.3);
  }
}

.profile .image img {
  width: 200px;
  border-radius: 50%;
  border: 5px solid rgba(255, 208, 0, 0.7);
  box-shadow: 0 0 35px rgba(255, 208, 0, 0.9);
  animation: pulse-glow 3s infinite;
}

@keyframes pulse-glow {
  0%, 100% {
    box-shadow: 0 0 25px rgba(255, 208, 0, 0.7),
                0 0 50px rgba(255, 255, 255, 0.3);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 45px rgba(255, 208, 0, 1),
                0 0 70px rgba(255, 255, 255, 0.5);
    transform: scale(1.03);
  }
}

.profile .text {
  margin-top: -70px;
  font-size: 25px;
  line-height: 0.9;
  text-shadow: 3px 3px 10px rgba(0, 0, 0, 0.9);
  font-weight: bold;
}

@media (max-width: 500px) {
  .profile .text p {
    padding-top: 10px;
    font-size: 12px;
    line-height: 0.1;
  }

  .profile::before {
    font-size: 32px;
    transform: translateX(-90px);
  }

  .profile::after {
    font-size: 28px;
    transform: translateX(90px);
  }
}

.profile .text p i {
  color: #ffffff;
}

.profile .text span {
  font-size: 30px;
  font-weight: 1000;
}

.profile .icon {
  padding-top: 20px;
  word-spacing: 15px;
}

.profile .icon i {
  font-size: 25px;
  color: #ffd000;
  transition: all 0.3s ease;
}

.profile .icon i:hover {
  font-size: 40px;
  color: #FFF;
  filter: drop-shadow(0 0 10px #ffd000);
  transform: scale(1.2) rotate(10deg);
}

/* start contant */
.contant {
  padding-top: 50px;
  color: #ffd000;
  text-align: center;
  padding-bottom: 48px;
  position: relative;
  background-color: rgba(0, 0, 0, 0.8);
}

.contant a {
  width: 100%;
  font-size: 40px;
  font-weight: 900;
  color: #ffd000;
  text-decoration: none;
  text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.8);
}

.contant .col span {
  display: none;
}

.contant .col {
  background-color: rgba(0, 0, 0, 0.6);
  height: 55px;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  border: #ffd000 3px solid;
  border-radius: 100px;
  font-weight: 900;
  position: relative;
  box-shadow: 0 0 25px rgba(255, 208, 0, 0.4);
  transition: all 0.5s ease;
}

/* إضاءة على الأزرار */
.contant .col::before {
  content: "✨";
  position: absolute;
  left: 25px;
  font-size: 20px;
  animation: sparkle-left 2s infinite;
}

.contant .col::after {
  content: "✨";
  position: absolute;
  right: 25px;
  font-size: 20px;
  animation: sparkle-right 2s infinite;
}

@keyframes sparkle-left {
  0%, 100% { opacity: 0; transform: translateX(0) scale(1); }
  50% { opacity: 1; transform: translateX(-5px) scale(1.2); }
}

@keyframes sparkle-right {
  0%, 100% { opacity: 0; transform: translateX(0) scale(1); }
  50% { opacity: 1; transform: translateX(5px) scale(1.2); }
}

.contant .col:hover span {
  display: inline;
  color: #000;
}

.contant .col:hover {
  height: 55px;
  width: 110%;
  border: #000000 3px solid;
  background: linear-gradient(135deg, #ffd000, #ffed4e);
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 0 40px rgba(255, 208, 0, 1),
              0 8px 25px rgba(0, 0, 0, 0.5);
}

.contant .col:hover a {
  color: #000000;
  font-weight: 900;
}

.contant .col:hover i {
  color: #000000;
  filter: drop-shadow(0 0 8px #ffffff);
  transform: scale(1.2);
}

@media (min-width: 500px) {
  .contant {
    padding-top: 30px;
    text-align: center;
    padding-bottom: 48px;
  }

  .contant .col {
    height: 55px;
    width: 65%;
    margin: auto;
  }

  .contant a {
    width: 100%;
    font-size: 29px;
    font-weight: 900;
  }

  .contant .col:hover {
    height: 55px;
    width: 75%;
  }
}

@media (max-width: 500px) {
  .contant {
    padding-left: 0px;
    width: 100%;
    padding: 30px 15px;
    text-align: center;
    padding-bottom: 80px;
  }

  .contant .col {
    height: 52px;
    width: 100%;
  }

  .contant .col::before {
    left: 15px;
    font-size: 16px;
  }

  .contant .col::after {
    right: 15px;
    font-size: 16px;
  }

  .contant a {
    font-size: 20px;
  }

  .contant .col:hover {
    height: 52px;
    width: 100%;
    transform: translateY(-5px);
  }

  .contant .col:hover span {
    display: none;
  }
}

.time {
  font-size: 30px;
  font-weight: 700;
  position: relative;
}

.time .container {
  color: #ffd000;
  text-align: center;
  text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
}

.time .container span {
  color: #ffffff;
  text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
}
